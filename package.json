{
  "name": "shelfready",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Makes small online stores buyable by AI shopping agents, with rule-guarded PayPal checkout. PayPal sandbox only.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "bench:run": "tsx scripts/run-benchmark.ts",
    "bench:record": "tsx scripts/record-run.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "ag-grid-community": "^34.0.0",
    "ag-grid-react": "^34.0.0",
    "ai": "^5.0.0",
    "drizzle-orm": "^0.44.0",
    "next": "^15.5.0",
    "pino": "^9.0.0",
    "postgres": "^3.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}

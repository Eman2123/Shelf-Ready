# Copy to .env.local and fill in. Never commit real values. Sandbox credentials only.

# --- App ---
APP_URL=http://localhost:3000
# true = seeded demo mode with recorded PayPal fixtures, needs no secrets below
DEMO_MODE=true

# --- Database (Neon or Supabase free tier, any Postgres works) ---
DATABASE_URL=

# --- PayPal sandbox ---
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- LLM (OpenAI-compatible endpoint; keys stay server-side, never NEXT_PUBLIC_) ---
# aiml | gemini
AI_PROVIDER=aiml
AIML_API_KEY=
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=

# --- Auth (Auth.js) ---
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Security ---
# HMAC secret for signed single-use approval links
APPROVAL_LINK_SECRET=
# protects scheduled endpoints (keep-alive, drift rescans)
CRON_SECRET=

# --- Optional: AG Studio trial licence (client-visible by design; app must run without it) ---
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=

# Frontend (public, non-secret)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
